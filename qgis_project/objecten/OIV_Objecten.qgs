                  <Option name="expression" value="CASE&#xd;&#xa;&#x9;WHEN &quot;label_positie&quot; LIKE '%links%' THEN 3&#xd;&#xa;&#x9;WHEN &quot;label_positie&quot; LIKE '%rechts%' THEN 5&#xd;&#xa;&#x9;ELSE 4&#xd;&#xa;END" type="QString"/>
