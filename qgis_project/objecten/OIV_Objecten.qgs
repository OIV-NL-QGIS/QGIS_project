    <Macros>
      <pythonCode type="QString">from qgis.utils import iface&#xd;from qgis.core import *&#xd;from qgis.gui import *&#xd;#try:&#xd;from update_dimension_tables_proj import run_update_dimension_tables&#xd;#except:&#xd;#    pass&#xd;&#xd;def getlayer_byname(layername):&#xd;    layer = None&#xd;    layers = QgsProject.instance().mapLayersByName(layername)&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;
    if layers:&#xd;        layer = layers[0]&#xd;    return (layer)&#xd;&#xd;def openProject():&#xd;	project = QgsProject.instance()&#xd;	projectConn = str(QgsExpressionContextUtils.projectScope(project).variable('connection'))&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;
	backgroundLayerName = QgsExpressionContextUtils.globalScope().variable('OIV_backgroundlayer')&#xd;	bagConn = QgsExpressionContextUtils.globalScope().variable('OIV_bag_connection')&#xd;	if bagConn:    &#xd;		bagLayerName = 'BAG panden - ' + QgsExpressionContextUtils.globalScope().variable('OIV_bag_connection')&#xd;	else:&#xd;		QgsExpressionContextUtils.setGlobalVariable('OIV_bag_connection', 'PDOK')&#xd;		bagLayerName = 'BAG panden - PDOK'&#xd;	bagLayer = getlayer_byname(bagLayerName)&#xd;	bkgrLayer = getlayer_byname(backgroundLayerName)&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;
	if bagLayer:&#xd;		QgsProject.instance().layerTreeRoot().findLayer(bagLayer.id()).setItemVisibilityChecked(True)&#xd;	if bkgrLayer:&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;
		QgsProject.instance().layerTreeRoot().findLayer(bkgrLayer.id()).setItemVisibilityChecked(True)&#xd;	projPath = QgsProject.instance().readPath("./")&#xd;	dbPath = projPath + '/db/dimension_tables.db'&#xd;	if projectConn == 'WFS':&#xd;		run_update_dimension_tables('geoserver.conf', dbPath, True, projectConn)&#xd;	else:&#xd;		run_update_dimension_tables('', dbPath, True, projectConn)&#xd;	layer = None&#xd;	layername = 'Veiligheidsregio'&#xd;	layer = getlayer_byname(layername)&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;
	if layer:&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;&#xd;
		layer.updateExtents()&#xd;		canvas = iface.mapCanvas()&#xd;		extent = layer.extent()&#xd;		canvas.setExtent(extent)&#xd;&#xd;def saveProject():&#xd;    pass&#xd;&#xd;def closeProject():&#xd;    pass</pythonCode>
