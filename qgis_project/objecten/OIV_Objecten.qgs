                  <Option type="QString" name="expression" value="CASE&#xd;&#xa;&#xd;&#xa;  WHEN &quot;label_positie&quot; = 'boven - links' THEN array(-0.6 * &quot;size&quot;, -0.6 * &quot;size&quot;)&#xd;&#xa;  WHEN &quot;label_positie&quot; = 'boven - midden' THEN array(0 * &quot;size&quot;, -0.6 * &quot;size&quot;)&#xd;&#xa;  WHEN &quot;label_positie&quot; = 'boven - rechts' THEN array(0.6 * &quot;size&quot;, -0.6 * &quot;size&quot;)&#xd;&#xa;  &#xd;&#xa;  WHEN &quot;label_positie&quot; = 'midden - links' THEN array(-0.6 * &quot;size&quot;, 0 * &quot;size&quot;)&#xd;&#xa;  WHEN &quot;label_positie&quot; = 'midden' THEN array(0 * &quot;size&quot;, 0 * &quot;size&quot;)&#xd;&#xa;  WHEN &quot;label_positie&quot; = 'midden - rechts' THEN array(0.6 * &quot;size&quot;, 0 * &quot;size&quot;)&#xd;&#xa;  &#xd;&#xa;  WHEN &quot;label_positie&quot; = 'onder - links' THEN array(-0.6 * &quot;size&quot;, 0.6 * &quot;size&quot;)&#xd;&#xa;  WHEN &quot;label_positie&quot; = 'onder - midden' THEN array(0 * &quot;size&quot;, 0.6 * &quot;size&quot;)&#xd;&#xa;  WHEN &quot;label_positie&quot; = 'onder - rechts' THEN array(0.6 * &quot;size&quot;, 0.6 * &quot;size&quot;)&#xd;&#xa;&#xd;&#xa;END"/>
